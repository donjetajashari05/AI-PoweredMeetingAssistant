# Copy this file to .env and fill in the values. Restart the server after changes.

# ---------- App & login ----------
# Long random string used to protect login codes and sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# Work emails that are administrators (comma separated). They can log in even
# before they are added on the "Ekipi" page.
ADMIN_EMAILS=
# Optional: only these email domains may log in (e.g. company.com)
ALLOWED_EMAIL_DOMAINS=
# Address used in email links
APP_URL=http://127.0.0.1:8000

# ---------- Email (any SMTP service) ----------
# Without SMTP_USER/SMTP_PASSWORD nothing is sent: emails appear on the
# "Emails sent" page and the login code is shown on screen.
#
# Gmail: SMTP_PASSWORD is a Google "App password" (Google account > Security >
# 2-Step Verification > App passwords), not the normal password.
#   SMTP_HOST=smtp.gmail.com
#
# Brevo (free: 300 emails/day): Brevo > SMTP & API > SMTP. SMTP_USER is the
# "Login" shown there (…@smtp-brevo.com), SMTP_PASSWORD is an SMTP key.
# MAIL_FROM is required and must be a sender verified in Brevo (Senders & IP).
#   SMTP_HOST=smtp-relay.brevo.com
#   MAIL_FROM=Meeting Memory <you@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Hour of the day (0-23) after which the daily reminder goes to each PM
REMINDER_HOUR=8

# ---------- Jira / Trello ----------
# Each PM can connect their own account on the page "Jira & Trello" (token stored encrypted
# with APP_SECRET). The values below are the fallback when the PM has not connected one.
# Which platform a project uses is set on the project (page Team); DEFAULT_TRACKER otherwise.
DEFAULT_TRACKER=jira
# Jira Cloud. API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://kompania.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ISSUE_TYPE=Task
# Trello. API key + token: https://trello.com/power-ups/admin
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_DEFAULT_BOARD=
# Test mode: no platform is called, tickets live in data/tracker_mock.json
JIRA_MOCK=
# How often ticket statuses are read back from Jira/Trello (minutes)
SYNC_MINUTES=30

# ---------- Duplicate check ----------
# Multilingual embeddings (needs sentence-transformers); without it: keywords + n-grams
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# both | semantic | keyword  (for the experiments)
DEDUP_MODE=both
# Minimum similarity of a candidate; empty = 0.55 with embeddings, 0.35 without
DEDUP_THRESHOLD=
# Where the embedding model is downloaded (put it on a disk with space)
# HF_HOME=D:\hf-cache

# ---------- AI ----------
# Claude API key for summaries, decisions and tasks (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# HuggingFace token for speaker diarization (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Free alternative for testing (used when ANTHROPIC_API_KEY is empty).
# Key: https://console.groq.com/keys   Note: transcripts are sent to Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Force a provider: anthropic or groq (empty = Claude if its key exists, else Groq)
LLM_PROVIDER=
